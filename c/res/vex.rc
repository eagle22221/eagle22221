1 ICON "res/vex.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SS"
            VALUE "FileDescription", "vex binary inspector"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "vex"
            VALUE "LegalCopyright", "Developed by SS"
            VALUE "OriginalFilename", "vex.exe"
            VALUE "ProductName", "vex"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
