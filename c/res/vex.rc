/* Resources of both Windows programs: the icon (id 1, also the window's icon,
 * see src/appwin.c) and the details Explorer shows under Properties > Details.
 * Built once as is for vex.exe and once with -DVEX_APP for vex-app.exe. */
#ifdef VEX_APP
#define VEX_DESCRIPTION "vex"
#define VEX_INTERNAL_NAME "vex-app"
#define VEX_FILE_NAME "vex-app.exe"
#else
#define VEX_DESCRIPTION "vex binary inspector"
#define VEX_INTERNAL_NAME "vex"
#define VEX_FILE_NAME "vex.exe"
#endif

1 ICON "res/vex.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SS"
            VALUE "FileDescription", VEX_DESCRIPTION
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", VEX_INTERNAL_NAME
            VALUE "LegalCopyright", "Developed by SS"
            VALUE "OriginalFilename", VEX_FILE_NAME
            VALUE "ProductName", "vex"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
